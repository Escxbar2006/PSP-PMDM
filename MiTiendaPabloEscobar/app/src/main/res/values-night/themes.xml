<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema de Escobar Music para Modo Noche (Material 3) -->
    <style name="Theme.MiTiendaPabloEscobar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Primarios -->
        <item name="colorPrimary">@color/black_piano</item>
        <item name="colorOnPrimary">@color/gold_vintage</item>
        <item name="colorPrimaryContainer">@color/gray_dark</item>
        <item name="colorOnPrimaryContainer">@color/gold_vintage</item>

        <!-- Colores Secundarios -->
        <item name="colorSecondary">@color/gold_vintage</item>
        <item name="colorOnSecondary">@color/black_piano</item>
        
        <!-- Superficies y Fondos -->
        <item name="colorSurface">@color/black_piano</item>
        <item name="colorOnSurface">@color/white_cream</item>
        <item name="android:windowBackground">@color/black_piano</item>
        
        <!-- Barra de Estado -->
        <item name="android:statusBarColor">@color/black_piano</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
